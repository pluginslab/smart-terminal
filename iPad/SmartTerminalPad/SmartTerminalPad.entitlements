<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The YubiKey lock: Apple's passkey API only works for a domain tied to the app.
	     pluginslab.com/.well-known/apple-app-site-association lists this app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:pluginslab.com</string>
	</array>
</dict>
</plist>
